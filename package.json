{
  "name": "phreeqc-runner",
  "displayName": "PHREEQC Runner",
  "description": "Run PHREEQC on the current input file with one click.",
  "version": "1.0.0",
  "publisher": "Amphos21ConsultingSL",
  "author": {
    "name": "Miquel de la Iglesia",
    "url": "https://github.com/miquel25"
  },
  "license": "GPL-3.0-or-later",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/amphos21-consulting/PHREEQC-Runner.git"
  },
  "bugs": {
    "url": "https://github.com/amphos21-consulting/PHREEQC-Runner/issues"
  },
  "homepage": "https://github.com/amphos21-consulting/PHREEQC-Runner#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "phreeqc",
    "geochemistry",
    "hydrogeochemistry",
    "usgs",
    "pqi"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PHREEQC Runner starts the PHREEQC executable, so it only runs in trusted workspaces. Developed by Miquel de la Iglesia at Amphos 21 Consulting S.L. (https://www.amphos21.com)"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "phreeqc",
        "aliases": [
          "PHREEQC",
          "phreeqc"
        ],
        "extensions": [
          ".pqi",
          ".ppi",
          ".phr",
          ".phrq"
        ],
        "icon": {
          "light": "./images/phreeqc.png",
          "dark": "./images/phreeqc.png"
        }
      },
      {
        "id": "phreeqc-output",
        "aliases": [
          "PHREEQC Output"
        ],
        "filenamePatterns": [
          "*.out",
          "*.pqo"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/phreeqc-output.png",
          "dark": "./images/phreeqc-output.png"
        }
      },
      {
        "id": "phreeqc-database",
        "aliases": [
          "PHREEQC Database"
        ],
        "filenamePatterns": [
          "*.dat"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phreeqc-output",
        "scopeName": "source.phreeqc.output",
        "path": "./syntaxes/phreeqc-output.tmLanguage.json"
      },
      {
        "language": "phreeqc-database",
        "scopeName": "source.phreeqc.database",
        "path": "./syntaxes/phreeqc-database.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "phreeqcRunner.run",
        "title": "Run PHREEQC",
        "icon": "$(play)"
      },
      {
        "command": "phreeqcRunner.stop",
        "title": "Stop PHREEQC",
        "icon": "$(debug-stop)"
      },
      {
        "command": "phreeqcRunner.selectInstallation",
        "title": "Select PHREEQC Installation Folder…"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "phreeqcRunner.run",
          "when": "resourceScheme == file && resourceExtname in phreeqcRunner.inputExtensions && resource not in phreeqcRunner.runningFiles",
          "group": "navigation"
        },
        {
          "command": "phreeqcRunner.stop",
          "when": "resource in phreeqcRunner.runningFiles",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "phreeqcRunner.run",
          "when": "resourceScheme == file && resourceExtname in phreeqcRunner.inputExtensions",
          "group": "phreeqc"
        }
      ],
      "commandPalette": [
        {
          "command": "phreeqcRunner.run",
          "when": "resourceScheme == file"
        },
        {
          "command": "phreeqcRunner.stop",
          "when": "phreeqcRunner.running"
        }
      ]
    },
    "keybindings": [
      {
        "command": "phreeqcRunner.run",
        "key": "ctrl+f5",
        "when": "editorTextFocus && resourceExtname in phreeqcRunner.inputExtensions"
      }
    ],
    "configuration": {
      "title": "PHREEQC Runner",
      "properties": {
        "phreeqcRunner.installationPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "order": 0,
          "markdownDescription": "Path to your PHREEQC installation folder, e.g. `C:\\Program Files\\USGS\\phreeqc-3.7.3-15968-x64`, or directly to the `phreeqc` executable. Leave empty to use the newest installation under `C:\\Program Files\\USGS`, or `phreeqc` from the PATH."
        },
        "phreeqcRunner.database": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "order": 1,
          "markdownDescription": "Database for input files that have no `DATABASE` line: an absolute path, or one relative to the input file's folder. Leave empty to use `database\\phreeqc.dat` from the installation. A `DATABASE` line in the input always wins."
        },
        "phreeqcRunner.outputExtension": {
          "type": "string",
          "default": ".pqo",
          "scope": "resource",
          "order": 2,
          "markdownDescription": "Extension of the output file, written next to the input under the same name (`model.pqi` → `model.pqo`)."
        },
        "phreeqcRunner.inputExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".pqi",
            ".ppi",
            ".phr",
            ".phrq"
          ],
          "scope": "window",
          "order": 3,
          "markdownDescription": "File extensions that get the **Run PHREEQC** button and `Ctrl+F5`. Any other file can still be run from the Command Palette."
        },
        "phreeqcRunner.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "order": 4,
          "description": "Save the input file before running PHREEQC."
        },
        "phreeqcRunner.openAfterRun": {
          "type": "string",
          "enum": [
            "none",
            "output",
            "selectedOutput"
          ],
          "enumDescriptions": [
            "Only show a notification with buttons to open the results.",
            "Open the output file (.pqo) beside the input.",
            "Open the selected output file(s) written by the run beside the input."
          ],
          "default": "output",
          "scope": "resource",
          "order": 5,
          "description": "What to open automatically after a successful run."
        }
      }
    }
  }
}